apply from: new File(projectDir.parentFile, 'gradle/yd-plugin-library.gradle')
apply plugin: 'org.jetbrains.kotlin.android'
android {
    namespace 'com.egogame.plugin.ui'
    buildFeatures { compose true }
    composeOptions { kotlinCompilerExtensionVersion '1.4.8' }
    kotlinOptions { jvmTarget = '1.8' }
}
dependencies {
    api project(':yd-plugin-api')
    compileOnly 'androidx.compose.runtime:runtime:1.6.1'
    compileOnly 'androidx.compose.ui:ui:1.6.1'
}
